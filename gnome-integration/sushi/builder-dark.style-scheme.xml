<?xml version="1.0" encoding="UTF-8"?>
<!--
  Override del fons fosc de GNOME Sushi.
  Sushi força sempre l'esquema "builder-dark" (text.js fa
  get_scheme('builder-dark')). Aquest fitxer manté el mateix id però el
  defineix CLAR (fons blanc, text fosc) perquè la previsualització de
  text/codi/markdown surti amb fons clar, com la resta de l'escriptori.

  Instal·lar a: /usr/share/sushi/gtksourceview-4/styles/builder-dark.style-scheme.xml
  (fes-ne còpia de seguretat de l'original abans).
-->
<style-scheme id="builder-dark" _name="Builder Light (override)" version="1.0">
  <author>override local</author>
  <_description>Esquema clar que reemplaça el builder-dark fosc de Sushi</_description>

  <!-- Palette -->
  <color name="white"      value="#FFFFFF"/>
  <color name="text_fg"    value="#2E3436"/>
  <color name="blue"       value="#1A5FB4"/>
  <color name="magenta"    value="#9C27B0"/>
  <color name="violet"     value="#6A5ACD"/>
  <color name="cyan"       value="#0E7C7B"/>
  <color name="gray"       value="#BEBEBE"/>
  <color name="green"      value="#26A269"/>
  <color name="bordeaux"   value="#A52A2A"/>
  <color name="red"        value="#C01C28"/>
  <color name="yellow"     value="#F5C211"/>
  <color name="purple"     value="#A020F0"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="text_fg" background="white"/>
  <style name="line-numbers"                foreground="#6f6f6f" background="#f6f5f4"/>
  <style name="current-line"                background="#f2f2f2"/>
  <style name="current-line-number"         background="#f2f2f2"/>
  <style name="draw-spaces"                 foreground="#babdb6"/>
  <style name="background-pattern"          background="#f9f9f9"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="white" background="gray"/>
  <style name="bracket-mismatch"            foreground="white" background="red"/>

  <!-- Search Matching -->
  <style name="search-match"                background="yellow"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="#6f8a6f" italic="true"/>
  <style name="def:shebang"                 foreground="#6f8a6f" bold="true"/>
  <style name="def:doc-comment-element"     italic="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="magenta"/>
  <style name="def:special-char"            foreground="violet"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="cyan"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="bordeaux" bold="true"/>

  <!-- Types -->
  <style name="def:type"                    foreground="green" bold="true"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         foreground="bordeaux" bold="true"/>
  <style name="def:inline-code"             foreground="cyan"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="blue"/>
  <style name="def:link-symbol"             foreground="blue" bold="true"/>
  <style name="def:link-destination"        italic="true" underline="single"/>
  <style name="def:heading"                 foreground="green" bold="true"/>
  <style name="def:thematic-break"          foreground="green" bold="true"/>
  <style name="def:preformatted-section"    foreground="cyan"/>
  <style name="def:list-marker"             foreground="bordeaux" bold="true"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="purple"/>
  <style name="def:error"                   foreground="white" background="red" bold="true"/>
  <style name="def:warning"                 background="yellow"/>
  <style name="def:note"                    foreground="blue" background="yellow" bold="true"/>
  <style name="def:net-address"             italic="true" underline="single"/>
</style-scheme>
